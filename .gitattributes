# =========================================
# weddingai.video — git-lfs file patterns
# Created 2026-08-05 during git bootstrap
# =========================================

# Video assets: keep in repo via LFS, not as regular git blobs
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.avi   filter=lfs diff=lfs merge=lfs -text
*.mkv   filter=lfs diff=lfs merge=lfs -text

# Large image formats (uncomment if/when ref images get big enough to matter)
# *.psd   filter=lfs diff=lfs merge=lfs -text
# *.ai    filter=lfs diff=lfs merge=lfs -text
# *.heic  filter=lfs diff=lfs merge=lfs -text

# Ensure consistent line endings (LF in repo, even on Windows)
# Note: we keep core.autocrlf=false, but this enforces LF for text files on commit.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

# CF Pages special files — MUST be LF or the entire _redirects / _headers
# file is silently dropped by the Pages edge parser (CRLF → "unparseable",
# file becomes a 404 page and zero rules apply). 2026-08-07 caught this the
# hard way: 9+ `test(redirects)` commits looked deploy-deployed but every
# one had zero effect on prod because the files came out of the Windows
# working tree as CRLF and the .gitattributes didn't override.
_redirects text eol=lf
_headers   text eol=lf
