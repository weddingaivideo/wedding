# Cloudflare Pages custom headers.
# References:
#   - https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers
#   - https://infosec.mozilla.org/guidelines/web_security

# IMPORTANT: Cloudflare Pages overrides Cache-Control on static assets at
# the CDN layer (CSS/JS/images get max-age=14400, HTML gets max-age=0).
# The _headers file CANNOT shorten these values. Workaround: bump the
# ?v= query string on every CSS/JS change. Custom headers (non-Cache-Control)
# do work — they're applied at the edge as expected.

# ---------- Security headers (applied to every page) -------------------------

/*
  # Content-Security-Policy: STATIC POLICY for non-HTML responses
  # (CSS/JS/images). For HTML pages the active policy is the per-request
  # nonce-bearing <meta http-equiv="Content-Security-Policy"> injected by
  # functions/_middleware.js (injectMetaCsp + buildCsp); CF Pages drops
  # CSP headers set from middleware (verified 2026-08-04).
  #
  # 2026-11-12: removed 'unsafe-inline' from script-src. The meta/nonce
  # path has been in production for several deploy cycles, static assets
  # contain no inline scripts, and deployed HTML has no inline event
  # handlers. script-src-attr in the meta policy already gates those.
  # KEEP 'unsafe-inline' in style-src — pages use style="" attributes and
  # inline <style id="critical-css">; removing it invents CSP violations
  # (see AGENTS.md "TRAP when writing such a harness").
  #
  # This file applies to the static-asset response path only. HTML responses
  # rebuilt by the middleware get their security headers from the
  # HTML_SECURITY_HEADERS object in functions/_middleware.js — keep the two
  # in sync when changing HSTS / XFO / XCTO / Referrer / Permissions / COOP /
  # COEP / Reporting-Endpoints.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://pagead2.googlesyndication.com https://cloudflareinsights.com https://*.cloudflareinsights.com https://www.clarity.ms https://f.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.clarity.ms https://c.clarity.ms https://c.bing.com https://pagead2.googlesyndication.com https://www.google.com; media-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com https://www.clarity.ms https://c.clarity.ms https://f.clarity.ms https://u.clarity.ms https://e.clarity.ms https://t.clarity.ms https://*.clarity.ms https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.googleadservices.com https://ep1.adtrafficquality.google; frame-src https://*.googlesyndication.com https://googleads.g.doubleclick.net; form-action 'self'
  #
  # 'wasm-unsafe-eval' (added 2026-11-09) must stay in BOTH this static
  # fallback and the per-request meta policy in functions/_middleware.js
  # (buildCsp). WebAssembly compilation is gated by its own CSP keyword, not
  # by 'unsafe-eval' - and 'unsafe-eval' is still absent. It is required by
  # the vendored /js/vendor/pica resampler and the ONNX Runtime Web build.
  # A whitelist entry left behind in one place and removed from the other
  # silently breaks the tool that needs it, so the two must move together.
  #
  # Reporting-Endpoints: required for the meta-delivered CSP's
  # `report-to csp-endpoint` directive to actually deliver violation
  # reports. Without this header, the browser knows WHERE to report
  # (per the meta tag) but not the endpoint URL. Reports are POSTed to
  # /functions/__csp_report.js, which logs to Cloudflare Pages
  # console (escalate later via Sentry / Slack webhook if noise becomes
  # unmanageable).
  Reporting-Endpoints: csp-endpoint="https://weddingai.video/__csp_report"
  #
  # Force HTTPS for 2 years; covers subdomains. `preload` is intentionally
  # omitted to keep the option reversible if the site ever needs to drop HTTPS.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Clickjacking protection (legacy header; CSP frame-ancestors is preferred
  # but X-Frame-Options still wins support across all browsers and proxies).
  X-Frame-Options: SAMEORIGIN
  # Modern browsers ignore X-XSS-Protection; setting it to 0 explicitly
  # disables the old filter to avoid known bypasses.
  X-XSS-Protection: 0
  # Disable powerful APIs the site does not use. Reduces the attack surface
  # if any third-party script is compromised.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # Isolate the browsing context: prevent window.opener access from cross-origin
  # popups. Helps mitigate Spectre-class side-channel attacks.
  Cross-Origin-Opener-Policy: same-origin
  # COEP `credentialless` (not `require-corp`) because we load cross-origin
  # iframes (AdSense via googlesyndication.com) that don't send CORP headers.
  # `require-corp` would break those embeds. `credentialless` is the practical
  # choice for a static site with ad embeds: cross-origin loads are allowed
  # but no credentials are sent, which is enough to enable cross-origin
  # isolation (SharedArrayBuffer, high-resolution timers) when we ever need them.
  Cross-Origin-Embedder-Policy: credentialless
  # Referrer policy for outbound links and resource requests.
  Referrer-Policy: strict-origin-when-cross-origin
  # Preconnect to known third-party origins (DNS + TCP + TLS warmup).
  # Speeds up the AdSense and Cloudflare Web Analytics beacons — the only two
  # third-party origins a page loads. GA4 and Baidu Tongji were removed
  # (2026-10-28), so no analytics origin needs warming. Only two origins are
  # warmed, well under the 4-preconnect Chrome warning.
  Link: <https://pagead2.googlesyndication.com>; rel=preconnect; crossorigin, <https://static.cloudflareinsights.com>; rel=preconnect; crossorigin


# ---------- Fine-grained per-type caching -------------------------------
# CSS/JS use ?v=N versioning so cache-busting is via query string.
# HTML is short-lived (1 min) so deploys propagate fast; pure static
# assets (images, fonts) cache 30 days. The CDN still enforces its own
# max-age=14400 for static — this only adjusts the HTML TTL.
/*.html
  Cache-Control: public, max-age=60
/blog/*/*.html
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=86400
/llms-full.txt
  Cache-Control: public, max-age=86400

# Images & fonts: long cache (1 year) since they have hashed filenames
# or are content-stable.

# ---------- Cross-Origin-Resource-Policy for static assets ---------------
# CORP `same-origin` on static assets (images, fonts, CSS, JS, video):
# blocks other origins from embedding our resources, mitigating speculative
# side-channel attacks (Spectre). HTML pages are intentionally excluded
# because we want them to be linkable / shareable on social platforms.
# (Audit recommendation, 2026-08-04; low risk but free security win.)
#
# Pattern notes (CF _headers glob uses single-segment `*`):
#   - `/styles*` matches BOTH `/styles/i18n.css` (folder) AND
#     `/styles.min.css` (root-level, no slash).
#   - `/js*` matches `/js/main.min.js` (folder) AND `/jsbundle.js` (root).
#   - `/images/*` covers /images/...; images never live at the root.
#   - `/fonts/*` covers /fonts/...; same.
# This avoids the duplicate-header issue you'd get from listing both
# `/js/*` and `/js/main.min.js` (CF would emit two CORP values,
# merged as "same-origin,same-origin").
/images/*
  Cross-Origin-Resource-Policy: same-origin
/fonts/*
  Cache-Control: public, max-age=31536000
  Cross-Origin-Resource-Policy: same-origin
/styles*
  Cross-Origin-Resource-Policy: same-origin
/js*
  Cross-Origin-Resource-Policy: same-origin

# ---------- Video files (hero loop + case studies) -----------------------
# The hero video file is content-addressable by name (hero-wedding-loop.{webm,mp4}).
# Cloudflare's CDN applies its own default cache to /images/* but being explicit
# here documents intent and works on non-CF deployments. We also force the proper
# Content-Type so the bytes start playing immediately without a MIME sniff.
# Note: CF overrides Cache-Control at the edge; this header still benefits from-
# CF-cache hits because the path matches /images/* anyway.
# Accept-Ranges: bytes is the default but explicit = no surprises with seeking
# (essential for autoplay browsers that start playback at a non-zero offset).
/images/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
/images/*.webm
  Content-Type: video/webm
  Accept-Ranges: bytes

# ---------- IndexNow verification key (no cache) ----------
# Public file served at /5067b1e4382cb39d55b68727db7c4011.txt. The key in
# indexnow-key.txt is "5067b1e4382cb39d55b68727db7c4011"; the file's name
# MUST match that key. IndexNow crawls this URL to verify site ownership
# before accepting URL submissions — keep aligned with indexnow-key.txt
# and submit-indexnow.ps1.
/5067b1e4382cb39d55b68727db7c4011.txt
  Cache-Control: no-store, must-revalidate