# WeddingAI.video — v3.8.0 URL rewrites for Cloudflare Pages
#
# Strategy: directory structure (`<page>/index.html`) + this _redirects file.
# - <page>/ (with trailing slash) is served directly by Pages as the
#   directory's index.html — 200 OK, 0 redirects, served cleanly.
# - <page>.html is 308'd to <page>/ for back-compat with old external
#   links / old Google index / any hard-coded .html URLs.
#
# We do NOT add rules for the no-extension no-slash form (e.g. /about).
# Pages' default 308 behavior for those is acceptable as a single back-compat
# hop. The internal site never links to that form.
#
# Why so few rules: more rules = more chances of self-redirects and
# conflict with Pages' own normalization (which strips trailing slashes
# before matching rules). Keep this minimal.

# Belt-and-suspenders 404 for the legacy GSC verification HTML template
# (production uses bca20c476d04af209950cbf5921e821d.txt instead; the
# .html template was never filled and was deleted 2026-07-28 but the
# catch-all `/*.html -> /:splat/ 308` rule below would otherwise 308-redirect
# to a nonexistent target). MUST be above the `/*.html` rule.
/google-site-verification.html    /404                            404

# .html back-compat: 308 redirect to the directory form for any depth.
# (TEMPORARILY REMOVED FOR TEST — restoring immediately)
# /*.html                          /:splat/                 308

# Homepage and per-language homepages — serve 200 directly. Without these,
# the `/*.html -> /:splat/ 308` rule above would catch /index.html and splat
# it to /index/ (a non-canonical intermediate that 308s again to /, a 2-hop
# chain), and /<lang>/index.html to /<lang>/index/ (which 404s for every
# language). Both chains are flagged by GSC as "Page automatically redirects"
# and were the root cause of the 2026-08-07 GSC indexing warning.
*/index.html         /:splat/                200

# Short URL aliases (v3.9.0) — for marketing / social / easy sharing.
# Each short slug 308s to its canonical /services/<category>/<service>/ URL.
# Both forms (with and without trailing slash) are listed because Pages
# does NOT auto-normalize a missing trailing slash (URL Normalization
# toggle is off to avoid 308 self-redirects). Without the no-slash rule
# below, /pet-wedding would SPA-fallback to the homepage instead of
# hitting this redirect.
/family-message/                 /services/absence-compensation/family-message/      308
/family-tribute/                 /services/absence-compensation/family-tribute/      308
/celebrity-message/              /services/absence-compensation/celebrity-message/   308
/slow-motion/                    /services/video-enhancement/slow-motion/           308
/vintage-restoration/            /services/video-enhancement/vintage-restoration/  308
/ai-video-generator/             /services/personalization/ai-video-generator/     308
/pet-wedding/                    /services/personalization/pet-wedding/             308
/wedding-trailer/                /services/personalization/wedding-trailer/         308
/multilingual/                   /services/personalization/multilingual/            308
/cartoon-style/                  /services/personalization/cartoon-style/           308
