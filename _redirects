# Belt-and-suspenders: even if Cloudflare's edge cache still has the old
# admin/leads/index.html (the new deployment removed the file but custom
# domain cache can lag), these 404 rules make sure /admin/leads/* always
# returns 404 regardless of cache state.
# (Added 2026-08-05 after the first deploy's edge cache kept serving the
# broken page for several minutes on the custom domain while the *.pages.dev
# preview URL correctly showed 404.)
/admin                           /404                            404
/admin/                          /404                            404
/admin/leads                     /404                            404
/admin/leads/                    /404                            404
/admin/leads/*                   /404                            404
/admin/*                         /404                            404

# Internal-only files (renamed from public paths 2026-07-28). The directory
# .assetsignore rule for internal-docs/ doesn't recursively exclude subfiles
# in wrangler 4.114, so .assetsignore-only protection leaves a 1-edge-rev
# window where /internal-docs/<file> can return 200. Belt-and-suspenders
# _redirects 404 for the full subtree.
/internal-docs                    /404                            404
/internal-docs/*                  /404                            404
/internal-admin                   /404                            404
/internal-admin/*                 /404                            404

# Bare filename globs in .assetsignore don't work in wrangler 4.114
# (caught 2026-07-28: /.gitignore and /.assetsignore were 200-OK despite
# the directory-level .assetsignore). The actual files are not deployable
# via the user-edited .assetsignore, so the only protection is _redirects
# 404 rules here.
# (These are deployment-config files, not user content. Kept in the repo
# because they affect local dev; the .git/ in the production path would
# be the same effect if we had a build step that uploaded it.)
# Note: /internal-docs/ and /internal-admin/ were 2026-07-28 moved out of
# the deploy root (to ../weddingai-private/), so wrangler no longer
# uploads them. Old cloud-side copies are still there but
# /internal-docs/ and /internal-admin/ already 404 because nothing
# matches them. No _redirects rules needed.
/.gitignore                       /404                            404
/.assetsignore                    /404                            404

