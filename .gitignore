# =========================================
# weddingai.video — project .gitignore
# Created 2026-08-05 during git bootstrap
# Last reviewed 2026-10-18 — added scripts/ + qa/*.html
# =========================================

# ---- Cloudflare / wrangler auth & state ----
.wrangler/
.dev.vars
.dev.vars.*
.dev.vars.example

# ---- One-off / temp scripts (project owner creates these ad hoc) ----
.tmp_*.py
.tmp*

# ---- tmp/ scratch space (228MB of one-off scripts, deploy logs, node_modules) ----
tmp/

# ---- One-off Python scripts (project owner creates these ad hoc) ----
scripts/

# ---- qa/ audit data dumps (regenerable; canonical scripts + reports stay in git) ----
qa/*.csv
qa/.google_reverse_cache.json
qa/.deploy*.log
qa/.dev*.log
qa/.seo-check.log
qa/incidents/

# ---- qa/ audit HTML snapshots (regenerable; canonical reports stay in git) ----
qa/*.html

# ---- qa/ux/ Playwright sweep output: raw JSON dumps + evidence screenshots ----
# ~4.9 MB and fully regenerable from qa/ux/sweep.py + evidence.py. The findings
# themselves live in qa/UX-TEST-REPORT-2026-10-20.md, which does stay in git.
qa/ux/results/

# ---- Deploy + log files ----
deploy-debug.log
*.log
*.log.used

# ---- Leftover / failed artifact patterns from broken ffmpeg/wrangler runs ----
*.corrupt
*.corrupt.deleted-*
*.bak
*.used
*.used.bak

# ---- Manual backup folders (use git history instead) ----
_backup-*/
_backup-*.used

# ---- Standard OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# ---- Python (any build/QA scripts the project might add later) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node (if anything ever needs npm in this project) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Secrets / local-only files (defense in depth — secret scan is the primary check) ----
.env
.env.*
*.pem
*.key
*.crt
id_rsa
id_dsa
id_ecdsa
id_ed25519
known_hosts
secrets.*
credentials.*

# ---- CF / Resend / project-specific token caches (NEVER commit) ----
.cf-tokens.txt
Custom Token key.txt
workers/

# ---- Build / generated artifacts ----
dist/
build/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
.vercel/

# ---- i18n body-translation pipeline scratch (intermediate work, not deliverable) ----
.translate-*.py
.verify*.py
jobs/
/0

# ---- Local probe results (regenerated on every verify run) ----
scripts/verify-redirects-toolfooters-results.csv

# ---- i18n pre-cleanup backups (regenerated when needed; not deliverable) ----
.en-backup/

# ---- One-off commit message drafts (project owner creates these ad hoc) ----
COMMIT_MSG_*.txt
COMMIT_MSG.txt

# ---- Local-only working files that must never be committed -------------
# .workbuddy/ holds local agent notes and working memory. The monthly i18n
# cron does a blanket `git add -A` + push, so without this rule those notes
# would be committed and shipped in the deploy payload. Ignore, never delete.
.workbuddy/

# private/ holds internal audits, probes and scan scripts (~220 files). It is
# already in .assetsignore, so it is not published - but it IS untracked, so a
# blanket `git add`/`git add -A` (the monthly i18n cron does exactly that in
# its "git add + commit + git push origin main" step) would commit it and
# push it into the deploy payload. Same for the one-off download dumps.
private/
dl.json
dl2.json
.cowork-temp-check.txt

# ---- One-off qa/ fixer scripts (the project owner creates these ad hoc) ----
# The canonical qa/ scripts stay tracked (build-i18n-shards.py,
# check_blog_redirects.py, deploy.py, gen_sitemap.py, qa_full_recheck.py,
# validate-deploy.py, validate-sitemap.py). These throwaway fixers and
# one-shot verifiers are not, and a blanket `git add` would otherwise sweep
# ~50 of them into the repo on every run.
qa/fix-*.py
qa/fix_*.py
qa/analyse-*.py
qa/find-*.py
qa/final-verify-*.py
qa/check-*.py
qa/proofread-*.py
qa/repair-*.py
qa/restore-*.py
qa/revert-*.py
qa/show-*.py
qa/survey-*.py
qa/unify-*.py
qa/verify-*.py
qa/pre-deploy-trust-check.py

# ---- qa/ux/ scratch probes (the canonical sweep stays tracked) ----
qa/ux/_*

# ---- i18n translation-job scratch state ----
i18n/.jobA_*.json
i18n/*.orphan-fixes.json