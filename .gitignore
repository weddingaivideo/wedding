# =========================================
# weddingai.video — project .gitignore
# Created 2026-08-05 during git bootstrap
# =========================================

# ---- Cloudflare / wrangler auth & state ----
.wrangler/
.dev.vars
.dev.vars.*
.dev.vars.example

# ---- One-off / temp scripts (project owner creates these ad hoc) ----
.tmp_*.py
.tmp*

# ---- tmp/ scratch space (228MB of one-off scripts, deploy logs, node_modules) ----
tmp/

# ---- qa/ audit data dumps (regenerable; canonical scripts + reports stay in git) ----
qa/*.csv
qa/.google_reverse_cache.json
qa/.deploy*.log
qa/.dev*.log
qa/.seo-check.log
qa/incidents/

# ---- Deploy + log files ----
deploy-debug.log
*.log
*.log.used

# ---- Leftover / failed artifact patterns from broken ffmpeg/wrangler runs ----
*.corrupt
*.corrupt.deleted-*
*.bak
*.used
*.used.bak

# ---- Manual backup folders (use git history instead) ----
_backup-*/
_backup-*.used

# ---- Standard OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# ---- Python (any build/QA scripts the project might add later) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node (if anything ever needs npm in this project) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Secrets / local-only files (defense in depth — secret scan is the primary check) ----
.env
.env.*
*.pem
*.key
*.crt
id_rsa
id_dsa
id_ecdsa
id_ed25519
known_hosts
secrets.*
credentials.*

# ---- Build / generated artifacts (project has none today; keep this section for the future) ----
dist/
build/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
.vercel/

# ---- Big media — keep in repo if you want history, exclude if you want a smaller clone ----
# (Currently EMPTY by design. Uncomment specific patterns if needed.)
# *.psd
# *.ai
# *.sketch
# *.fig
